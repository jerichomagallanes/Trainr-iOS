    "pro_faq_cancel_a": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes. You keep Pro until the period you have paid for ends, and nothing you have generated or logged is taken away."
          }
        }
      }
    },
    "pro_faq_cancel_q": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can I cancel any time?"
          }
        }
      }
    },
    "pro_faq_devices_a": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro follows your Google account, not the device. Sign in with the same Google account and tap Restore purchase. Trainr has no accounts of its own, so a purchase made on iOS does not unlock Android."
          }
        }
      }
    },
    "pro_faq_devices_q": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What happens if I get a new phone?"
          }
        }
      }
    },
    "pro_faq_free_a": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first week, every set you log, the rest timer, the video on every exercise, and all your past weeks and progress."
          }
        }
      }
    },
    "pro_faq_free_q": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What stays free?"
          }
        }
      }
    },
    "pro_faq_human_a": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No. Trainr builds it on your phone from the answers you gave, and progresses it from the sets you log. Plans are guidance, not medical advice."
          }
        }
      }
    },
    "pro_faq_human_q": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is my plan written by a real trainer?"
          }
        }
      }
    },
    "pro_faq_includes_a": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro unlocks every week after your first: build next week from what you lifted, repeat a week that went well, rewrite one that does not suit you, start a fresh plan whenever your goal changes, and removes the ad from your plan."
          }
        }
      }
    },
    "pro_faq_includes_q": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What does Trainr Pro include?"
          }
        }
      }
    },
    "pro_faq_renew_a": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monthly and Yearly renew at the end of each period until you cancel. Lifetime is a single payment and never renews."
          }
        }
      }
    },
    "pro_faq_renew_q": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does Pro renew automatically?"
          }
        }
