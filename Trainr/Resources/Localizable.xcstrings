    },
    "bmi_cdc_categories": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CDC: Adult BMI categories"
          }
        }
      }
    },
    "bmi_explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BMI is weight in kilograms divided by height in metres squared. Imperial measurements are converted first. Trainr shows adult categories only from age 20."
          }
        }
      }
    },
    "bmi_label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BMI:"
          }
        }
      }
    },
    "bmi_limitations": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BMI does not distinguish muscle from fat and cannot assess your health on its own. It is not a body-fat measurement or a diagnosis. Discuss questions about your measurements or health with a qualified healthcare professional."
          }
        }
      }
    },
    "bmi_ranges": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adult ranges (kg/m²): underweight below 18.5; healthy weight 18.5 to below 25; overweight 25 to below 30; obesity 30 and above. The category uses the unrounded result; the displayed number is rounded to one decimal place."
          }
        }
      }
    },
    "bmi_screening_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For adults 20 and older. A screening measure, not a diagnosis."
          }
        }
      }
    },
    "bmi_source_date": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sources reviewed 2 October 2026. Links open the CDC website in English."
          }
        }
      }
    },
    "bodyweight_only": {
