<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Check proves each generation request came from this app on a real
	     device through App Attest, which needs this entitlement and the matching
	     capability on the App ID. Production is the only environment Firebase
	     accepts; development attestations are refused. -->
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>production</string>
</dict>
</plist>
